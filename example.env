# app version (optional - set at build time from git tag, falls back to package.json)
# NEXT_PUBLIC_APP_VERSION=v.1.0.0

# ipfs gateway proxy
NEXT_PUBLIC_IPFS_GATEWAY_PROXY_URL=https://api.gateway-proxy.vechain.org

# b32 name service
B32_URL=https://b32.vecha.in

# coingecko api proxy
NEXT_PUBLIC_COIN_API_URL=https://coin-api.veworld.vechain.org

# indexer
NEXT_PUBLIC_VEWORLD_INDEXER_MAINNET_URL=https://indexer.mainnet.vechain.org
NEXT_PUBLIC_VEWORLD_INDEXER_TESTNET_URL=https://indexer.testnet.vechain.org
# Optional: overrides the hardcoded solo default in lib/constants/dev-mode.ts
# NEXT_PUBLIC_VEWORLD_INDEXER_SOLO_URL=http://localhost:8080

# Optional solo contract overrides (local dev only; prod/preview builds ignore dev mode)
# NEXT_PUBLIC_SOLO_B3TR_ADDRESS=0x...
# NEXT_PUBLIC_SOLO_VOT3_ADDRESS=0x...
# NEXT_PUBLIC_SOLO_STARGATE_NFT_ADDRESS=0x...
# NEXT_PUBLIC_SOLO_STARGATE_DELEGATION_ADDRESS=0x...

# translations
OPENAI_API_KEY=your-openai-api-key-here
