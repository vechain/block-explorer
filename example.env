# app version (optional - set at build time from git tag, falls back to package.json)
# NEXT_PUBLIC_APP_VERSION=v.1.0.0

# ipfs gateway proxy
NEXT_PUBLIC_IPFS_GATEWAY_PROXY_URL=https://api.gateway-proxy.vechain.org

# Upstreams the browser calls itself. Runtime-injected, so they reach the bundle through
# /runtime-config.json rather than being baked into it. All optional.
# B32_URL=https://b32.vecha.in
# OPENCHAIN_URL=https://api.openchain.xyz/signature-database/v1/lookup
# SOURCIFY_URL=https://sourcify.dev/server

# coingecko api proxy
NEXT_PUBLIC_COIN_API_URL=https://coin-api.veworld.vechain.org

# indexer
NEXT_PUBLIC_VEWORLD_INDEXER_MAINNET_URL=https://indexer.mainnet.vechain.org
NEXT_PUBLIC_VEWORLD_INDEXER_TESTNET_URL=https://indexer.testnet.vechain.org
# Optional: overrides the hardcoded solo default in lib/constants/dev-mode.ts
# NEXT_PUBLIC_VEWORLD_INDEXER_SOLO_URL=http://localhost:8089

# Exposes /api/metrics for the ADOT sidecar to scrape over 127.0.0.1. Auto-enabled when
# NODE_ENV=development. Only set this where a load balancer rule blocks the path publicly.
# METRICS_ENABLED=true

# Dev mode (solo network + configurable solo endpoints). Auto-enabled when NODE_ENV=development.
# Read at container runtime — set via docker-compose `environment:` or similar.
# ALLOW_DEV_MODE=true

# Optional solo contract overrides (runtime; used when dev mode is allowed)
# SOLO_B3TR_ADDRESS=0x...
# SOLO_VOT3_ADDRESS=0x...
# SOLO_STARGATE_NFT_ADDRESS=0x...
# SOLO_STARGATE_DELEGATION_ADDRESS=0x...

# translations
OPENAI_API_KEY=your-openai-api-key-here
