{
  "uid": "be-overview",
  "title": "Block explorer overview (${env})",
  "description": "CloudFront and WAF metrics from CloudWatch in us-east-1, which is the only region either publishes to. The WAF request detail row is CloudWatch Logs Insights, which bills on bytes scanned \u2014 it stays collapsed so it runs only while open, and this dashboard refreshes every minute. Terraform owns this dashboard, so edits made here are replaced on the next apply.",
  "tags": ["block-explorer", "${env}"],
  "timezone": "utc",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Block explorer",
      "tags": ["block-explorer"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total requests",
      "description": "Everything CloudFront answered over the selected range, cache hits included. There is no origin server, so this is the whole of the serving path.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "Requests",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "",
          "matchExact": true,
          "label": "Requests"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per minute",
      "description": "Viewer requests, whether CloudFront served them from cache or fetched the object from the bucket.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "Requests",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "label": "Requests"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Percentages of viewer requests, not counts. 404 is expected background: the edge router answers a malformed block id or address with one rather than serving the shell. 403 is the one to read as an outage \u2014 a bundle prefix the bucket does not hold reads as 403, so a step change there is a bad activate.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "403"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [8, 4]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "5xxErrorRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "label": "5xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "403ErrorRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "label": "403"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "404ErrorRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "label": "404"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "4xxErrorRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "label": "4xx total"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Cache and origin",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Share of cacheable requests served from an edge cache. Every key under a bundle prefix is immutable and the prefix is in the cache key, so this belongs above 90% \u2014 the cdn-cache-hit-rate-low alarm fires under 80%.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "CacheHitRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "300",
          "matchExact": true,
          "label": "Hit rate"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Cache hit rate over time",
      "description": "A dip right after a deploy is the invalidation of runtime-config.json plus a cold prefix, and recovers within minutes. A step down that stays is the routing store pointing hosts somewhere unexpected.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "CacheHitRate",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "300",
          "matchExact": true,
          "label": "Hit rate"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Origin latency",
      "description": "Time to first byte for the requests that missed cache and went to the bucket. Only misses are measured, so this stays flat while the hit rate moves.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "OriginLatency",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "p50",
          "period": "300",
          "matchExact": true,
          "label": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "OriginLatency",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "p90",
          "period": "300",
          "matchExact": true,
          "label": "p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "OriginLatency",
          "dimensions": {
            "DistributionId": "${distribution_id}",
            "Region": "Global"
          },
          "statistic": "p99",
          "period": "300",
          "matchExact": true,
          "label": "p99"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Edge router",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Router invocations and errors",
      "description": "The viewer-request function runs on every request and is the only code left on the serving path, so an execution error is a request that never resolved to a bundle key. Errors are on the right axis: at healthy volumes the two share no scale.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*errors|Throttles"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "FunctionInvocations",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Invocations"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "FunctionExecutionErrors",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Execution errors"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "FunctionValidationErrors",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Validation errors"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "FunctionThrottles",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Throttles"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Router compute utilisation",
      "description": "Share of the function's maximum allowed execution time. CloudFront throttles a function that keeps reaching 100%, so sustained readings above 80% are the warning that the router needs trimming.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "FunctionComputeUtilization",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": false,
          "label": "Utilisation"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Routing store reads",
      "description": "The per-request lookup of host to bundle prefix. A read error means the router fell back rather than resolving the host, which is what serving the wrong bundle would look like from here.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource_uid_cloudwatch}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Read errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "KvsReadRequests",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Reads"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource_uid_cloudwatch}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/CloudFront",
          "metricName": "KvsReadErrors",
          "dimensions": {
            "FunctionName": "${router_function_name}",
            "Region": "Global"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "label": "Read errors"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "WAF",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Requests allowed and blocked",
      "description": "Every request is one or the other, so these two sum to the Requests panel above. Blocked is only ever the rate-limit rule while waf_managed_rules_blocking is off. Requests a soaking rule flagged are not a third category — they are allowed requests, and they are in the Allowed line here; the two panels below cover them.",
      "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Allowed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Blocked" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "AllowedRequests",
          "dimensions": { "WebACL": "${waf_web_acl_name}", "Rule": "ALL" },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "label": "Allowed"
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "BlockedRequests",
          "dimensions": { "WebACL": "${waf_web_acl_name}", "Rule": "ALL" },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "label": "Blocked"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Blocked by rule",
      "description": "Which rule rejected the request. Only rate-limit-ip and the blocklist rules reject while waf_managed_rules_blocking is off — the rate limiter takes sustained traffic from a single IP to trip, so a steady blocklist line against an empty rate-limit one is the normal reading. A rule that has never blocked publishes no metric, so it stays absent from the legend rather than drawing a zero line.",
      "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "BlockedRequests",
          "dimensions": {
            "WebACL": "${waf_web_acl_name}",
            "Rule": [
              "${waf_rule_prefix}-rate-limit-ip",
              "${waf_rule_prefix}-blocklist-cidr",
              "${waf_rule_prefix}-blocklist-asn",
              "${waf_rule_prefix}-ip-reputation",
              "${waf_rule_prefix}-anonymous-ip",
              "${waf_rule_prefix}-common",
              "${waf_rule_prefix}-known-bad-input"
            ]
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "label": "$${PROP('Dim.Rule')}"
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Count-mode match rate",
      "description": "Matches on a soaking rule as a share of requests served. Nothing here was rejected — this is what would start being rejected if waf_managed_rules_blocking flipped to true, so it is the cost of turning the managed groups on rather than a measure of attack traffic.",
      "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "CountedRequests",
          "dimensions": { "WebACL": "${waf_web_acl_name}", "Rule": "ALL" },
          "statistic": "Sum",
          "period": "300",
          "matchExact": true,
          "id": "counted",
          "hide": true
        },
        {
          "refId": "B",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "AllowedRequests",
          "dimensions": { "WebACL": "${waf_web_acl_name}", "Rule": "ALL" },
          "statistic": "Sum",
          "period": "300",
          "matchExact": true,
          "id": "allowed",
          "hide": true
        },
        {
          "refId": "C",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "${region}",
          "namespace": "",
          "metricName": "",
          "dimensions": {},
          "statistic": "Sum",
          "period": "",
          "matchExact": true,
          "id": "share",
          "expression": "100 * counted / allowed",
          "label": "of served traffic"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Count-mode matches by rule",
      "description": "A rule in Count mode records the match and hands the request to the next rule, so all of this was served. Read it as a dry run of blocking, and against the Requests panel for scale. The rate-limit rule never appears: it blocks outright. A blocklist rule appears here only where waf_blocklist_blocking is still off, and moves to Blocked by rule once it flips.",
      "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/WAFV2",
          "metricName": "CountedRequests",
          "dimensions": {
            "WebACL": "${waf_web_acl_name}",
            "Rule": [
              "${waf_rule_prefix}-blocklist-cidr",
              "${waf_rule_prefix}-blocklist-asn",
              "${waf_rule_prefix}-ip-reputation",
              "${waf_rule_prefix}-anonymous-ip",
              "${waf_rule_prefix}-common",
              "${waf_rule_prefix}-known-bad-input"
            ]
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "label": "$${PROP('Dim.Rule')}"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "WAF request detail — Logs Insights, runs only while expanded",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "panels": [
        {
          "id": 43,
          "type": "stat",
          "title": "Flagged traffic over the range",
          "description": "The denominator for the two tables below. This log group holds only the requests a rule matched, a few percent of what Total requests counts — Count-mode match rate above puts a figure on that share. Where clients and paths run to thousands, the top 20 rows below are the head of a long tail rather than its bulk.",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "gridPos": { "h": 4, "w": 24, "x": 0, "y": 45 },
          "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
          "options": {
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "orientation": "horizontal",
            "colorMode": "none",
            "graphMode": "none",
            "textMode": "value_and_name"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
              "queryMode": "Logs",
              "region": "${region}",
              "logGroupNames": ["${waf_log_group}"],
              "expression": "stats count(*) as flagged, count_distinct(httpRequest.clientIp) as clients, count_distinct(httpRequest.uri) as paths"
            }
          ]
        },
        {
          "id": 40,
          "type": "table",
          "title": "Flagged clients",
          "description": "Who tripped a rule, by source IP. action says what then happened: ALLOW is the count-mode dry run and the request was served, BLOCK is a real rejection. flagged counts that client's matched requests, never its whole traffic. A cloud scraper spreads itself over a range, so one actor arrives here as many small rows — the totals above are its real size.",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "gridPos": { "h": 11, "w": 12, "x": 0, "y": 49 },
          "fieldConfig": {
            "defaults": { "custom": { "align": "auto", "filterable": true } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "flagged" },
                "properties": [
                  { "id": "unit", "value": "short" },
                  { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
                ]
              },
              {
                "matcher": { "id": "byName", "options": "action" },
                "properties": [
                  { "id": "custom.width", "value": 90 },
                  {
                    "id": "mappings",
                    "value": [
                      {
                        "type": "value",
                        "options": {
                          "ALLOW": { "text": "ALLOW", "color": "green", "index": 0 },
                          "BLOCK": { "text": "BLOCK", "color": "red", "index": 1 }
                        }
                      }
                    ]
                  },
                  { "id": "custom.cellOptions", "value": { "type": "color-text" } }
                ]
              }
            ]
          },
          "options": { "showHeader": true, "sortBy": [{ "displayName": "flagged", "desc": true }] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
              "queryMode": "Logs",
              "region": "${region}",
              "logGroupNames": ["${waf_log_group}"],
              "expression": "fields httpRequest.clientIp as clientIp, httpRequest.country as country, httpRequest.uri as path, coalesce(nonTerminatingMatchingRules.0.ruleId, labels.0.name, terminatingRuleId) as rule\n| stats count(*) as flagged, count_distinct(path) as paths, count_distinct(rule) as rules by clientIp, country, action\n| sort flagged desc\n| limit 20"
            }
          ]
        },
        {
          "id": 41,
          "type": "table",
          "title": "Flagged paths",
          "description": "What those requests asked for. Explorer routes mean real users behind a flagged IP range; probe paths — wp-login, .env, phpmyadmin — mean the rule is earning its place. clients is how many distinct sources asked for that path. flagged is matched requests only, so a path sits far below its real share of Requests per minute.",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "gridPos": { "h": 11, "w": 12, "x": 12, "y": 49 },
          "fieldConfig": {
            "defaults": { "custom": { "align": "auto", "filterable": true } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "flagged" },
                "properties": [
                  { "id": "unit", "value": "short" },
                  { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
                ]
              },
              {
                "matcher": { "id": "byName", "options": "method" },
                "properties": [{ "id": "custom.width", "value": 80 }]
              }
            ]
          },
          "options": { "showHeader": true, "sortBy": [{ "displayName": "flagged", "desc": true }] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
              "queryMode": "Logs",
              "region": "${region}",
              "logGroupNames": ["${waf_log_group}"],
              "expression": "fields httpRequest.uri as path, httpRequest.httpMethod as method, httpRequest.clientIp as clientIp, coalesce(nonTerminatingMatchingRules.0.ruleId, labels.0.name, terminatingRuleId) as rule\n| stats count(*) as flagged, count_distinct(clientIp) as clients by path, method, rule\n| sort flagged desc\n| limit 20"
            }
          ]
        },
        {
          "id": 42,
          "type": "table",
          "title": "Recent WAF events",
          "description": "The log group holds only requests a rule matched — the delivery filter drops the rest, so this is not a request log. rule is the ACL rule; managedRule is the specific rule inside the AWS managed group, and that is the one to name when deciding what to exclude before turning blocking on. Column headers filter.",
          "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
          "gridPos": { "h": 14, "w": 24, "x": 0, "y": 60 },
          "fieldConfig": {
            "defaults": { "custom": { "align": "auto", "filterable": true } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "action" },
                "properties": [
                  { "id": "custom.width", "value": 130 },
                  {
                    "id": "mappings",
                    "value": [
                      {
                        "type": "value",
                        "options": {
                          "ALLOW": { "text": "ALLOW (served)", "color": "green", "index": 0 },
                          "BLOCK": { "text": "BLOCK (rejected)", "color": "red", "index": 1 }
                        }
                      }
                    ]
                  },
                  { "id": "custom.cellOptions", "value": { "type": "color-text" } }
                ]
              }
            ]
          },
          "options": { "showHeader": true, "sortBy": [{ "displayName": "@timestamp", "desc": true }] },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "cloudwatch", "uid": "${datasource_uid_cloudwatch}" },
              "queryMode": "Logs",
              "region": "${region}",
              "logGroupNames": ["${waf_log_group}"],
              "expression": "fields @timestamp, action, coalesce(nonTerminatingMatchingRules.0.ruleId, labels.0.name, terminatingRuleId) as rule, coalesce(ruleGroupList.0.nonTerminatingMatchingRules.0.ruleId, ruleGroupList.0.terminatingRule.ruleId, labels.0.name) as managedRule, httpRequest.country as country, httpRequest.clientIp as clientIp, httpRequest.httpMethod as method, httpRequest.uri as path\n| sort @timestamp desc\n| limit 200"
            }
          ]
        }
      ]
    }
  ]
}
