# Preview Environment Configuration Template
# This file is a template. GitHub Actions will create actual config files
# for each preview environment (e.g., preview-pr-123.yaml)

environment: preview-pr-{PR_NUMBER}
region: eu-west-1

# Domain configuration
domain: pr-{PR_NUMBER}.block-explorer-preview.vechain.org
enable_custom_domain: true

# Docker image configuration
# GitHub Actions will set this to pr-{PR_NUMBER}-{COMMIT_SHA}
image_tag: pr-{PR_NUMBER}-{COMMIT_SHA}

# App Runner instance configuration
# Smaller resources for preview environments
cpu: 264
memory: 512
port: 3000

# Auto-scaling configuration
min_size: 1        # Minimum instances (App Runner requires at least 1)
max_size: 2        # Maximum 2 instances
max_concurrency: 100  # Max concurrent requests per instance

# Health check
health_check_path: /
node_env: production

# Optional: Additional environment variables for the application
environment_variables:
  NEXT_PUBLIC_NETWORK: testnet
  NEXT_PUBLIC_PREVIEW: "true"
  # Add more env vars as needed
