# YACE exports AWS CloudWatch metrics as Prometheus metrics on :5000. It exists
# because the AWS ADOT distribution ships no CloudWatch receiver, so this is the
# only way the ALB, WAF and (from phase 7) ElastiCache numbers land in the same
# Prometheus store as the app's own.
#
# Adding a metric: another entry under the relevant job's `metrics:`. Adding a
# namespace: another entry under `discovery.jobs`. Schema is the v1alpha1 layout
# used from YACE v0.63 on.

apiVersion: v1alpha1
sts-region: ${aws_region}

discovery:
  # Resource tags become Prometheus labels, which is what lets a dashboard
  # aggregate `by (Name)` instead of by ARN suffix.
  exportedTagsOnMetrics:
    AWS/ApplicationELB: ["Name"]

  # Every job carries these. Without them discovery returns every tagged
  # resource in the account — faucet-app shares explorer-dev — and the rules
  # below aggregate without a project filter, so another team's 5xx would page
  # us. Anchored because YACE treats the value as a regex.
  jobs:
    # Per-service task counts, for the EcsTaskDrift rule and the
    # tasks-below-desired alarms. Per-task cgroup metrics do not come from here
    # — each app task's own sidecar writes those straight to AMP, so they carry
    # an aws_ecs_task_id label this job could never attach.
    - type: ECS/ContainerInsights
      regions: [${aws_region}]
      searchTags:
        - key: Project
          value: ^${project}$
        - key: Environment
          value: ^${env}$
      period: 60
      length: 60
      metrics:
        - name: DesiredTaskCount
          statistics: [Average]
        - name: RunningTaskCount
          statistics: [Average]

    - type: AWS/ApplicationELB
      regions: [${aws_region}]
      searchTags:
        - key: Project
          value: ^${project}$
        - key: Environment
          value: ^${env}$
      period: 60
      length: 60
      metrics:
        - name: RequestCount
          statistics: [Sum]
        - name: HTTPCode_Target_5XX_Count
          statistics: [Sum]
        - name: HTTPCode_ELB_5XX_Count
          statistics: [Sum]
        - name: TargetResponseTime
          statistics: [Average]
        - name: HealthyHostCount
          statistics: [Maximum]
%{ if waf_enabled ~}

    # Discovery rather than a static block: WAF publishes one series per rule
    # plus a Rule="ALL" aggregate, and enumerating those by hand would go stale
    # the moment a rule is added.
    - type: AWS/WAFV2
      regions: [${aws_region}]
      searchTags:
        - key: Project
          value: ^${project}$
        - key: Environment
          value: ^${env}$
      period: 60
      length: 60
      metrics:
        - name: AllowedRequests
          statistics: [Sum]
        - name: BlockedRequests
          statistics: [Sum]
        - name: CountedRequests
          statistics: [Sum]
%{ endif ~}
