extensions:
  sigv4auth:
    region: ${aws_region}
    service: aps
  health_check:
    endpoint: 0.0.0.0:13133

receivers:
  awsecscontainermetrics:
    collection_interval: 20s
%{ if app_port != null ~}
  # Same-task scrape of the app's /api/metrics. awsvpc mode shares the network
  # namespace across containers in a task, so 127.0.0.1 reaches the app and the
  # endpoint never has to cross the ALB.
  prometheus:
    config:
      scrape_configs:
        - job_name: local-app
          scrape_interval: 30s
          metrics_path: /api/metrics
          static_configs:
            - targets: ['127.0.0.1:${app_port}']
          relabel_configs:
            - target_label: source
              replacement: app-${service_name}
%{ endif ~}

processors:
  # Drop the collector's own service.* resource attrs: with
  # resource_to_telemetry_conversion on, they would collide with the `service`
  # external label set per task below.
  resource:
    attributes:
      - key: service.name
        action: delete
      - key: service.instance.id
        action: delete
      - key: service.version
        action: delete
%{ if app_port != null ~}
  # Fills aws.ecs.task.id and friends onto the scraped app metrics, so
  # aws_ecs_task_id lands as a Prometheus label and individual tasks within a
  # service can be told apart.
  resourcedetection:
    detectors: [ecs]
    override: false
%{ endif ~}
  batch:
    timeout: 30s

exporters:
  prometheusremotewrite:
    endpoint: ${amp_endpoint}api/v1/remote_write
    auth:
      authenticator: sigv4auth
    external_labels:
      env: ${env}
      source: ecs-sidecar
      service: ${service_name}
    resource_to_telemetry_conversion:
      enabled: true

service:
  extensions: [sigv4auth, health_check]
  pipelines:
    metrics:
%{ if app_port != null ~}
      receivers: [awsecscontainermetrics, prometheus]
      processors: [resourcedetection, resource, batch]
%{ else ~}
      receivers: [awsecscontainermetrics]
      processors: [resource, batch]
%{ endif ~}
      exporters: [prometheusremotewrite]
  telemetry:
    logs:
      level: info
