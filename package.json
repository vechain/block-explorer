{
  "name": "block-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "validate": "pnpm build && pnpm test && pnpm lint && pnpm format:check && pnpm knip",
    "prepare": "husky",
    "translate": "dotenv -e .env npx translo-cli@latest",
    "ts-check": "tsc -p tsconfig.json --noEmit",
    "ts-check:staged": "node scripts/ts-check-staged.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.26.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.85.6",
    "@tanstack/react-query-devtools": "^5.85.6",
    "@vechain/sdk-core": "^2.0.7",
    "@vechain/sdk-network": "^2.0.7",
    "bignumber.js": "^9.3.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.4.2",
    "i18next-resources-to-backend": "^1.2.1",
    "motion": "^12.23.22",
    "next": "15.5.8",
    "next-i18n-router": "^5.5.3",
    "next-themes": "^0.4.6",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "recharts": "^3.2.1",
    "viem": "^2.36.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.8",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.63.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.0",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm -s ts-check:staged"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "node scripts/knip-check.mjs"
    ],
    "*.{js,jsx,ts,tsx,json,jsonc,md,css,scss}": [
      "prettier --write"
    ]
  }
}
