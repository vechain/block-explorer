{
  "name": "block-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "validate": "pnpm build && pnpm test && pnpm lint && pnpm format:check && pnpm knip",
    "prepare": "husky",
    "translate": "dotenv -e .env npx translo-cli@latest",
    "ts-check": "tsc -p tsconfig.json --noEmit",
    "ts-check:staged": "node scripts/ts-check-staged.mjs",
    "token-registry:update": "node scripts/update-token-registry.mjs",
    "token-registry:check": "node scripts/check-token-registry.mjs",
    "ghcr:push": "docker build -t ghcr.io/vechain/block-explorer:latest . && docker push ghcr.io/vechain/block-explorer:latest"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@vechain/picasso": "^2.1.1",
    "@vechain/sdk-core": "^2.0.7",
    "@vechain/sdk-network": "^2.0.7",
    "date-fns": "^4.2.1",
    "i18next": "^25.4.2",
    "i18next-resources-to-backend": "^1.2.1",
    "mixpanel-browser": "^2.79.0",
    "motion": "^12.40.0",
    "next": "15.5.8",
    "next-i18n-router": "^5.5.8",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "viem": "^2.50.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.11",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.8",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.63.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm -s ts-check:staged"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "node scripts/knip-check.mjs"
    ],
    "*.{js,jsx,ts,tsx,json,jsonc,md,css,scss}": [
      "prettier --write"
    ]
  }
}
