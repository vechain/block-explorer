{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Rome",
  "schedule": ["before 8am on the first day of the month"],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies", "increment:patch"],
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Batch minor/patch/digest/pin updates into a single monthly PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Disable major bumps for framework anchors (manual migration)",
      "matchPackageNames": ["next", "react", "react-dom", "@chakra-ui/react"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Disable major bumps for the docker node base image",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on the first day of the month"],
    "groupName": "lockfile maintenance",
    "labels": ["dependencies", "lockfile", "increment:patch"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security", "increment:patch"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "0",
    "prCreation": "immediate"
  }
}
