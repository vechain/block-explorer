{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)", ":disableRateLimiting"],
  "timezone": "Europe/Rome",
  "schedule": ["before 8am on the first day of the month"],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Tag non-major bumps with increment:patch for the release-versioning gate",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "addLabels": ["increment:patch"]
    },
    {
      "description": "Tag major bumps with increment:major so the release reflects the breaking dependency change",
      "matchUpdateTypes": ["major"],
      "addLabels": ["increment:major"]
    },
    {
      "description": "Batch minor/patch/digest/pin updates into a single monthly PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Disable major bumps for framework anchors (manual migration)",
      "matchPackageNames": ["next", "react", "react-dom", "@chakra-ui/react"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Disable major bumps for the docker node base image",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8am on the first day of the month"],
    "groupName": "lockfile maintenance",
    "addLabels": ["lockfile", "increment:patch"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security", "increment:patch"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate"
  }
}
